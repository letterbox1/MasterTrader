# =============================================================================
# MasterTrader — every key, token and account the whole system needs (P0 → P8)
# =============================================================================
#
# HOW TO USE
#   1. cp .env.example .env              (.env is git-ignored; never commit it)
#   2. Fill the values, service by service. docs/ENV-SETUP.md has the exact steps for
#      each block (same order and headings as this file). Leave anything you don't use
#      blank; nothing breaks, the matching feature stays off until the value exists.
#   3. just secrets-generate              fills every MT_* value (generated, not yours to invent)
#   4. just secrets-seal                  encrypts .env into ~/.config/mastertrader/secrets.sops.env
#                                         (sops + age), verifies it, then shreds the plaintext .env
#   5. just secrets-check                 lists which names are set / missing (never shows values)
#   Later changes: `just secrets-edit` (opens the sealed file in your editor), or put only the new
#   lines in a fresh .env and run `just secrets-seal --merge`.
#
# NAMING CONVENTION (every name in the project follows it)
#   <SERVICE>_<ENVIRONMENT>_<ROLE>_<FIELD>
#   SERVICE      the provider as it brands itself:  BINANCE, OANDA, FRED, TELEGRAM, B2 …
#   ENVIRONMENT  trading venues only:               TESTNET | PRACTICE | DEMO | PAPER | LIVE
#   ROLE         what the key is for (venues):      READONLY  (balances, fills, reconciliation)
#                                                   PAPER | HITL | AUTO  (one sub-account per mode)
#                                                   DEADMAN   (the dead-man sidecar: cancel/flatten only)
#   FIELD        API_KEY | API_SECRET | API_PASSPHRASE | API_TOKEN | ACCOUNT_ID | USERNAME |
#                PASSWORD | CLIENT_ID | CLIENT_SECRET | BOT_TOKEN | CHAT_ID | URL | EMAIL
#   Prefix MT_   generated by MasterTrader (`just secrets-generate`); leave blank.
#   Prefix VITE_ public values compiled into the web app. NEVER put a secret in a VITE_ name.
#
# NEVER IN THIS FILE
#   - wallet seeds or private keys (vault, warm, hot, identity, burner): the signer creates and
#     holds hot/identity/burner keys itself; vault and warm keys never leave your hardware wallets
#   - the offline worm_owner database password (its own offline file, P0-T013)
#   - your MCP client token (it lives in your OS keychain on the client, P8-T018)
#
# Each line: what it is · first phase that uses it · the task that needs it.
# =============================================================================


# ── 1. You and your login ────────────────────────────────────────────────────
# Email for your one Supabase Auth login (the owner account) · P0 · P0-T062
OWNER_EMAIL=


# ── 2. LLM providers ─────────────────────────────────────────────────────────
# Anthropic API key (set a monthly spend limit in the console) · P0 · P0-T007, P0-T068
ANTHROPIC_API_KEY=
# Your own OpenAI-compatible endpoint, if you have one (leave blank to disable the route) · P0 · P0-T007
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=
# Hugging Face read token, only if a model you choose is gated · P0 · P0-T043, P0-T044
HUGGINGFACE_TOKEN=


# ── 3. Telegram (alerts, approvals, kill switch; channel postures) ───────────
# Bot from @BotFather · P0 · P0-T002, P0-T073, P1-T060
TELEGRAM_BOT_TOKEN=
# Your personal chat id with the bot (approvals and /kill come only from this chat) · P0 · P0-T002
TELEGRAM_OWNER_CHAT_ID=
# Where alerts go (same as the owner chat, or a private group) · P1 · P1-T060
TELEGRAM_ALERTS_CHAT_ID=
# The dedicated reader account's app from my.telegram.org (channel postures only) · P4 · P4-T006, P4-T068
TELEGRAM_READER_API_ID=
TELEGRAM_READER_API_HASH=


# ── 4. Email alerts (optional third channel) ─────────────────────────────────
# An app password from your mail provider, never your main password · P1 · P1-T068
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_APP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=


# ── 5. Discord feeds server ──────────────────────────────────────────────────
# Bot application with the Message Content intent · P4 · P0-T008, P4-T068, P5-T061
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Your private "MasterTrader Feeds" server and its #mt-inbox channel (ids, not secrets) · P4 · P4-T002
DISCORD_FEEDS_SERVER_ID=
DISCORD_INBOX_CHANNEL_ID=


# ── 6. Off-site backups (Backblaze B2 with Object Lock) ──────────────────────
# S3 endpoint shown on your buckets, e.g. https://s3.us-west-004.backblazeb2.com · P0 · P0-T006
B2_S3_ENDPOINT=
# Database backups (pgBackRest repository + WAL archive) · P0 · P0-T057
B2_PGBACKREST_BUCKET=
B2_PGBACKREST_KEY_ID=
B2_PGBACKREST_APPLICATION_KEY=
# File backups (restic snapshots: Parquet catalog, configs, sealed secrets copy) · P0 · P0-T057
B2_RESTIC_BUCKET=
B2_RESTIC_KEY_ID=
B2_RESTIC_APPLICATION_KEY=
# WORM daily seals and monthly immutable exports · P0 · P0-T073
B2_WORM_SEAL_BUCKET=
B2_WORM_SEAL_KEY_ID=
B2_WORM_SEAL_APPLICATION_KEY=
# Alternative to B2: a second box running `restic rest-server --append-only` (leave B2 blank) · P0 · P0-T006
RESTIC_REST_SERVER_URL=


